{
  "name": "dsh-refine",
  "version": "1.0.2",
  "description": "UX layer for the dsh continual-harness engine (dsh-continual-harness): /refine human command + settings panel with entry browsing, refinement history timeline, one-click rollback, and auto-gate audit — engine optional at runtime.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node smoke-host.mjs",
    "smoke": "node smoke-host.mjs",
    "prepublishOnly": "npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dushaobindoudou/dsh-refine.git"
  },
  "homepage": "https://github.com/dushaobindoudou/dsh-refine",
  "bugs": {
    "url": "https://github.com/dushaobindoudou/dsh-refine/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "prime-agent",
    "refine",
    "continual-harness",
    "agent",
    "self-improvement"
  ],
  "author": "dushaobindoudou",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": false
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1"
  }
}
